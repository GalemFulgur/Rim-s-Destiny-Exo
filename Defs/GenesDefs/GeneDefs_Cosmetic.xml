<?xml version="1.0" encoding="utf-8" ?>
<Defs>

 <GeneDef>
    <defName>RD_ExoHead</defName>
    <label>Exomind Head</label>
    <description>Carriers of this gene bear a robotic Exomind head.</description>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>400</displayOrderInCategory>
    <iconPath>UI/Icons/Genes/Gene_ExoHead</iconPath>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
		<forcedHeadTypes>
			<li>RD_Male_Exo_Exo_01</li>
			<li>RD_Male_Exo_Exo_02</li>      
      <li>RD_Male_Exo_Exo_03</li>
			<li>RD_Male_Exo_Exo_04</li>
			<li>RD_Male_Exo_Exo_05</li>      
      <li>RD_Male_Exo_Exo_06</li>      
			<li>RD_Female_Exo_Exo_01</li>
			<li>RD_Female_Exo_Exo_02</li>
			<li>RD_Female_Exo_Exo_03</li>
			<li>RD_Female_Exo_Exo_04</li>  
			<li>RD_Female_Exo_Exo_05</li>  
			<li>RD_Female_Exo_Exo_06</li>                                     
		</forcedHeadTypes>
    <renderNodeProperties>
      <li>
        <baseLayer>5</baseLayer>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <parentTagDef>Body</parentTagDef>
      </li>
    </renderNodeProperties>
  </GeneDef>

  <GeneDef ParentName="GeneEyeColor">
    <defName>RD_Exo_Eyes</defName>
    <label>Exo eyes</label>
		<displayCategory>Miscellaneous</displayCategory>
    <description>Carriers of this gene have digital robotic Exomind eyes.</description>
    <iconPath>UI/Icons/Genes/Gene_ExoEyes</iconPath>
    <displayOrderInCategory>0</displayOrderInCategory>
    <renderNodeProperties> 
      <li Class="PawnRenderNodeProperties_Eye">
        <colorType>Hair</colorType>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <texPath>Things/Pawn/Humanlike/Exo/HeadAttachments/Eyes/Male/Male_Exoeyes</texPath>
        <texPathFemale>Things/Pawn/Humanlike/Exo/HeadAttachments/Eyes/Female/Female_Exoeyes</texPathFemale>
        <anchorTag>RightEye</anchorTag>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <parentTagDef>Head</parentTagDef>
        <drawSize>0.14</drawSize>
        <side>Right</side>
        <drawData>
          <defaultData>
            <layer>54</layer>
            <offset>(0.01, 0, -0.25)</offset>
          </defaultData>       
        </drawData>
      </li>
      <li Class="PawnRenderNodeProperties_Eye">
        <colorType>Hair</colorType>
        <texPath>Things/Pawn/Humanlike/Exo/HeadAttachments/Eyes/Male/Male_Exoeyes</texPath>
        <texPathFemale>Things/Pawn/Humanlike/Exo/HeadAttachments/Eyes/Female/Female_Exoeyes</texPathFemale>
        <anchorTag>LeftEye</anchorTag>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <parentTagDef>Head</parentTagDef>
        <drawSize>0.14</drawSize>
        <side>Left</side>
        <drawData>
          <defaultData>
            <layer>54</layer>
            <offset>(-0.01, 0, -0.25)</offset>
            <flip>true</flip>
          </defaultData>
          <dataWest>
            <flip>false</flip>
          </dataWest>
        </drawData>         
      </li>     
    </renderNodeProperties>
  </GeneDef>  

	<GeneDef>
		<defName>RD_RadiolariaBlood</defName>
		<label>radiolaria blood</label>
		<displayCategory>Miscellaneous</displayCategory>
		<description>Carriers of this gene have a radiolaria powered metabolism, and as such will bleed radiolaria instead of normal human blood.
Spilled Radiolaria slightly reduces consciousness of organic beings walking on it.
During Blood transfusion Carriers will give or receive Radiolaria instead of hemogen.</description>
		<iconPath>UI/Icons/Genes/Gene_RadiolariaBlood</iconPath>
		<displayOrderInCategory>0</displayOrderInCategory>
	
		<exclusionTags>
			<li>BloodType</li>
			<li>Blood</li>
		</exclusionTags>
		<selectionWeight>0</selectionWeight>
    <biostatMet>1</biostatMet>
		<biostatCpx>1</biostatCpx>
<modExtensions>
	<li Class="VEF.Genes.GeneExtension">		  
		<customBloodThingDef>RD_Filth_Radiolaria</customBloodThingDef>
		<customBloodIcon>UI/Icons/Medical/RD_Bleeding_Radiolaria</customBloodIcon>
		<customBloodEffect>RD_Damage_HitRadiolaria</customBloodEffect>
		<customWoundsFromFleshtype>RD_WoundRadiolaria</customWoundsFromFleshtype>
	</li>
</modExtensions>    
	</GeneDef>

<!-- Head attachements -->

  <GeneDef Name="GeneExoExtensionBase" Abstract="True">
    <biostatCpx>0</biostatCpx>
    <displayCategory>Cosmetic</displayCategory>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <exclusionTags>
      <li>ExoExtension</li>
    </exclusionTags>      
  </GeneDef>

  <GeneDef ParentName="GeneExoExtensionBase">
    <defName>RD_ExoHorn</defName>
    <label>Exo horn</label>
    <description>Carriers of this gene have one or multiple robotic horn(s) on their head.</description>
    <iconPath>UI/Icons/Genes/Gene_ExtensionHorn</iconPath>
    <displayCategory>Cosmetic</displayCategory>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <displayOrderInCategory>500</displayOrderInCategory>
    <biostatCpx>0</biostatCpx>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <parentTagDef>Head</parentTagDef>
        <colorType>Hair</colorType>
        <useRottenColor>true</useRottenColor>
        <useSkinShader>true</useSkinShader>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <texPaths>
          <li>Things/Pawn/Humanlike/Exo/HeadAttachments/Horns/Exo_HornA</li>
          <li>Things/Pawn/Humanlike/Exo/HeadAttachments/Horns/Exo_HornB</li>
          <li>Things/Pawn/Humanlike/Exo/HeadAttachments/Horns/Exo_HornC</li>
          <li>Things/Pawn/Humanlike/Exo/HeadAttachments/Horns/Exo_HornD</li>
          <li>Things/Pawn/Humanlike/HeadAttachments/EmptyHeadAttachement</li>                     
        </texPaths>
        <visibleFacing>
          <li>East</li>
          <li>South</li>
          <li>West</li>
        </visibleFacing>
        <narrowCrownHorizontalOffset>0.03</narrowCrownHorizontalOffset>
        <baseLayer>80</baseLayer>
      </li>
    </renderNodeProperties>
  </GeneDef>  

