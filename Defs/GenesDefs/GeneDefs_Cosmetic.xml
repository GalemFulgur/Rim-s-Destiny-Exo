        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <parentTagDef>Head</parentTagDef>
        <colorType>Hair</colorType>
        <useRottenColor>true</useRottenColor>
        <useSkinShader>true</useSkinShader>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <texPaths>
        <li>Things/Pawn/Humanlike/Exo/HeadAttachments/Plates/Exo_PlateA</li>
        <li>Things/Pawn/Humanlike/Exo/HeadAttachments/Plates/Exo_PlateB</li>
        <li>Things/Pawn/Humanlike/Exo/HeadAttachments/Plates/Exo_PlateC</li>
        <li>Things/Pawn/Humanlike/Exo/HeadAttachments/Plates/Exo_PlateD</li>                 
